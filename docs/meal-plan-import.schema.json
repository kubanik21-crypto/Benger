{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benger.example/schema/meal-plan-v1",
  "title": "Benger meal plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schemaVersion",
    "namespace",
    "id",
    "version",
    "label",
    "from",
    "to",
    "meals"
  ],
  "properties": {
    "format": {
      "const": "benger.meal-plan"
    },
    "schemaVersion": {
      "const": 1
    },
    "namespace": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$",
      "not": {
        "enum": [
          "constructor",
          "prototype",
          "__proto__"
        ]
      }
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$",
      "not": {
        "enum": [
          "constructor",
          "prototype",
          "__proto__"
        ]
      }
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "\\S"
    },
    "from": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "to": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "meals": {
      "type": "array",
      "minItems": 7,
      "maxItems": 56,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "date",
          "meal",
          "order",
          "recipe",
          "amount",
          "unit"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$",
            "not": {
              "enum": [
                "constructor",
                "prototype",
                "__proto__"
              ]
            }
          },
          "date": {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "meal": {
            "enum": [
              "breakfast",
              "lunch",
              "dinner",
              "snack"
            ]
          },
          "order": {
            "type": "integer",
            "minimum": 0,
            "maximum": 55
          },
          "recipe": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "namespace",
              "id",
              "version"
            ],
            "properties": {
              "namespace": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$",
                "not": {
                  "enum": [
                    "constructor",
                    "prototype",
                    "__proto__"
                  ]
                }
              },
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$",
                "not": {
                  "enum": [
                    "constructor",
                    "prototype",
                    "__proto__"
                  ]
                }
              },
              "version": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000000
              },
              "variant": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$",
                    "not": {
                      "enum": [
                        "constructor",
                        "prototype",
                        "__proto__"
                      ]
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "amount": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 10000000
          },
          "unit": {
            "enum": [
              "serving",
              "g",
              "ml"
            ]
          },
          "notes": {
            "type": "string",
            "maxLength": 1000
          }
        }
      }
    }
  },
  "$comment": "Dodatkowa walidacja semantyczna: dokładnie 7 kolejnych dni from..to, pokrycie każdego dnia, unikalne meal.id oraz date/order, istniejące konkretne wersje przepisów i wariantów."
}
