<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_background">
<LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:orientation="horizontal">
<TextView android:id="@+id/widget_header" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center_vertical" android:maxLines="2" android:ellipsize="end" android:text="Benger" android:textStyle="bold" android:textSize="14sp" android:textColor="@color/widget_fg" />
<TextView android:id="@+id/widget_refresh" android:layout_width="48dp" android:layout_height="match_parent" android:gravity="center" android:text="↻" android:textSize="28sp" android:contentDescription="Odśwież dane w Bengerze" android:textColor="@color/widget_fg"/>
</LinearLayout>
<LinearLayout android:id="@+id/widget_match_panel" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:visibility="gone">
<TextView android:id="@+id/widget_score" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textSize="18sp" android:maxLines="1" android:ellipsize="end" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="16sp" android:autoSizeMaxTextSize="24sp" android:autoSizeStepGranularity="1sp" android:textStyle="bold" android:fontFamily="monospace" android:background="@drawable/widget_score_background" android:paddingTop="4dp" android:paddingBottom="4dp" android:textColor="@color/widget_score_text"/>
<TextView android:id="@+id/widget_match_caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textSize="11sp" android:textColor="@color/widget_muted"/>
<ImageView android:id="@+id/widget_court" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="48dp" android:scaleType="fitCenter" android:contentDescription="Koszykarskie boisko"/>
<TextView android:id="@+id/widget_match_days" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:maxLines="1" android:textSize="12sp" android:textColor="@color/widget_fg"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Dziś tymczasowo · dotknij, aby zobaczyć zasady" android:gravity="center" android:textSize="10sp" android:textColor="@color/widget_muted"/>
</LinearLayout>
<TextView android:id="@+id/widget_kcal" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/widget_fg" android:maxLines="1" android:ellipsize="end"/>
<TextView android:id="@+id/widget_goal" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/widget_muted" android:maxLines="2"/>
<ProgressBar android:id="@+id/widget_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="8dp" android:progressTint="@color/widget_fg"/>
<TextView android:id="@+id/widget_training" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="44dp" android:gravity="center_vertical" android:textSize="14sp" android:textColor="@color/widget_fg" android:maxLines="2" android:ellipsize="end"/>
<TextView android:id="@+id/widget_updated" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/widget_muted"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal">
<TextView android:id="@+id/widget_meal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:layout_marginEnd="4dp" android:background="@drawable/widget_shortcut_background" android:text="+ Posiłek" android:textStyle="bold" android:textColor="@color/widget_fg"/>
<TextView android:id="@+id/widget_weight" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:layout_marginStart="4dp" android:background="@drawable/widget_shortcut_background" android:text="+ Waga" android:textStyle="bold" android:textColor="@color/widget_fg"/>
</LinearLayout>
</LinearLayout>